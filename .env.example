# Copy to .env and fill in. Every server variable lives in config.mjs.
# Never commit real values.

# ---- Server ----
PORT=4178                       # port the server listens on
HOST=127.0.0.1                  # 127.0.0.1 keeps it local; 0.0.0.0 opens it up
NODE_ENV=development            # "production" turns on all fail-closed checks

# ---- Mode flags ----
CONTEXTSEAL_DEMO_MODE=            # 1 forces synthetic demo mode (safe, no auth)
CONTEXTSEAL_REQUIRE_AUTH=         # 1 requires the auth token outside production
CONTEXTSEAL_ED25519=              # 1 turns on Ed25519 receipt signing

# ---- Secrets (32+ chars in production) ----
RECEIPT_SIGNING_KEY=              # legacy HMAC signing secret; required in production
CONTEXTSEAL_AUTH_TOKEN=           # bearer token; required when auth is enabled
CONTEXTSEAL_SIGNING_KEY=          # Ed25519 private key (PEM) for real receipt signatures
CONTEXTSEAL_EVIDENCE_WRAPPING_KEY= # 32-byte hex or base64 key encrypting evidence exports
CONTEXTSEAL_EVIDENCE_KEY_ID=      # label stored in packages; change when rotating the key

# ---- Storage (one required outside demo mode) ----
DATABASE_URL=                   # Postgres URL for receipts
RECEIPT_LEDGER_PATH=            # or a file path for the JSON ledger

# ---- Tuning ----
CONTEXTSEAL_APPROVAL_TTL_MS=300000        # approval expiry, default 5 minutes
CONTEXTSEAL_MAX_REQUESTS_PER_MINUTE=60    # rate limit; bad values fall back to 60
